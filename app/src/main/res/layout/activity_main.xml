<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#0f0f1a"
            app:title="@string/app_name"
            app:titleTextColor="#ffffff"
            app:navigationIconTint="#ffffff">

            <androidx.mediarouter.app.MediaRouteButton
                android:id="@+id/media_route_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:visibility="visible" />
        </com.google.android.material.appbar.MaterialToolbar>

        <EditText
            android:id="@+id/buscador"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_margin="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_buscador"
            android:textColor="#ffffff"
            android:textColorHint="#aaaaaa"
            android:hint="Buscar canal..."
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_canales"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:clipToPadding="false" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/drawer_contenido"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#151528">

        <TextView
            android:id="@+id/titulo_drawer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Categorías"
            android:textColor="#ffffff"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_categorias"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/reproductor_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:show_buffering="when_playing"
            app:resize_mode="fit" />

        <Button
            android:id="@+id/btn_cerrar_reproductor"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:text="✕"
            android:textColor="#ffffff"
            android:background="@drawable/bg_boton_cerrar" />

        <Button
            android:id="@+id/btn_enviar_cast"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:text="Enviar a TV"
            android:textColor="#ffffff"
            android:background="@drawable/bg_boton_cerrar" />
    </FrameLayout>

</androidx.drawerlayout.widget.DrawerLayout>
